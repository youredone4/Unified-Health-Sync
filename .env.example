# HealthSync configuration.
#
#   cp .env.example .env     then fill in the values below.
#
# .env holds secrets. It is git-ignored — never commit it, never paste it
# into chat or email. Generate secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Signs login session cookies. At least 32 characters; changing it logs
# everyone out.  openssl rand -hex 32
SESSION_SECRET=

# --- Docker deployment (docker-compose.yml) --------------------------------
# Database credentials. Use letters and digits only in the password
# (openssl rand -hex 24) because it is embedded in a connection URL.
POSTGRES_USER=healthsync
POSTGRES_PASSWORD=
POSTGRES_DB=healthsync

# Address people type to reach the system.
#   Public domain:  healthsync.example.gov.ph
#   LAN only:       https://192.168.1.10   (and uncomment `tls internal` in Caddyfile)
SITE_ADDRESS=

# --- Local development (npm run dev) ---------------------------------------
# Not used by docker-compose.yml, which builds its own from POSTGRES_* above.
# This default matches docker-compose.dev.yml.
DATABASE_URL=postgres://healthsync:healthsync_dev@localhost:5432/healthsync

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Inserts FABRICATED demo patients and records. Leave false on any database
# that holds real patient data.
SEED_DEMO_DATA=false

# AI insights + plain-language recommendation summaries. When blank, those
# features fall back to the built-in rule-based output.
# Data sent to OpenAI leaves the Philippines — see docs/deployment.md.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# SMS via Semaphore (https://semaphore.co). Blank = SMS are logged, not sent.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# SMS_DAILY_LIMIT_PER_BARANGAY=

# PhilHealth Konsulta integration. Blank = disabled.
PHILHEALTH_API_BASE_URL=
PHILHEALTH_API_KEY=
PHILHEALTH_PROVIDER_CODE=

# Local dev only: port for `npm run dev` (default 5000).
# PORT=5000
